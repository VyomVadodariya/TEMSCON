{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index?__path=/health"
    },
    {
      "source": "/health/",
      "destination": "/api/index?__path=/health"
    },
    {
      "source": "/api",
      "destination": "/api/index?__path=/health"
    },
    {
      "source": "/api/",
      "destination": "/api/index?__path=/health"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index?__path=/api/:match*"
    }
  ]
}
